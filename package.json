  "version": "0.1.0",
  "publisher": "BryanCuneo",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BryanCuneo/powershell-scope-null-conditional-scopes"
  },
  "contributes": {
    "grammars": [
      {
        "scopeName": "powershell.null-conditional-operators.injection",
        "path": "./syntaxes/null-conditional-operators.json",
